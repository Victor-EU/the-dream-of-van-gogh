# The source scans: 1.7 GB of museum photography, gathered for the sibling piece and read from
# ref/originals/, outside the repository. paintings/CREDITS.md records what they are.
ref/

# The local Python environment behind tools/.
.venv/

.DS_Store
__pycache__/

# Every frame a tool has ever taken. The ones the log keeps are copied into docs/ by name.
shots/

# tools/lines.py keeps the edition's pages it read, so a check can be re-run without asking the
# edition again. letters/letters.json is the record; this is only the cache behind it.
letters/.cache/

# A deploy tool's marker, tied to whichever project this folder was last deployed as.
.telbase/
